<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Metrolib;component/Themes/Constants.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Tailviewer;component/Themes/Semantic.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Tailviewer;component/Themes/Fluent.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
    GREEN
    <Color x:Key="Primary">#27ae60</Color>
    <Color x:Key="PrimaryLight">#34AD66</Color>
    <Color x:Key="PrimaryLighter">#3FAA6A</Color>
    <Color x:Key="PrimaryDark">#1BAD58</Color>
    <Color x:Key="PrimaryForeground">#FFFFFF</Color>
    -->

    <SolidColorBrush x:Key="UnfocusedOverlayBrush" Color="{DynamicResource UnfocusedOverlay}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{DynamicResource TitleBar}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource Primary}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLight}" />
    <SolidColorBrush x:Key="PrimaryLighterBrush" Color="{DynamicResource PrimaryLighter}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{DynamicResource PrimaryDark}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{DynamicResource PrimaryForeground}" />
    <SolidColorBrush x:Key="PrimarySeparatorBrush" Color="{DynamicResource PrimarySeparator}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{DynamicResource Secondary}" />
    <SolidColorBrush x:Key="SecondaryLightBrush" Color="{DynamicResource SecondaryLight}" />
    <SolidColorBrush x:Key="SecondaryLighterBrush" Color="{DynamicResource SecondaryLighter}" />
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{DynamicResource SecondaryDark}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{DynamicResource SecondaryForeground}" />

    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{DynamicResource OverlayBackground}" />

    <!-- Shadows Metrolib's light-gray SeparatorBrush so that the neutral separator/border color follows the theme. -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="{DynamicResource Divider}" />

</ResourceDictionary>