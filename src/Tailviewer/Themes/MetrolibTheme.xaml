<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Metrolib.Controls;assembly=Metrolib"
                    xmlns:converters="clr-namespace:Metrolib.Converters;assembly=Metrolib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Tailviewer;component/Themes/Constants.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#B7B7B7" />

    <converters:NullOrEmptyStringToVisibleConverter x:Key="EmptyToVisibleConverter" />
    <converters:NonEmptyStringToVisibleConverter x:Key="NonEmptyStringToVisibleConverter" />
    <converters:BoolFalseToCollapsedConverter x:Key="BoolFalseToCollapsedConverter" />
    <converters:IncrementByOneConverter x:Key="IncrementByOneConverter" />

    <!-- Flat icon buttons: idle = theme color, hover/press = darker theme shade, disabled = neutral gray -->
    <Style TargetType="{x:Type controls:FlatIconButton}" BasedOn="{StaticResource {x:Type controls:FlatIconButton}}">
        <Setter Property="NormalForeground" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="HoveredForeground" Value="{DynamicResource PrimaryDarkBrush}" />
        <Setter Property="PressedForeground" Value="{DynamicResource PrimaryDarkBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

