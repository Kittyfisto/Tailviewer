<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: dark surfaces with bright text. -->

    <Color x:Key="ThemeWindowBackground">#252526</Color>
    <Color x:Key="ThemePanelBackground">#2D2D30</Color>
    <Color x:Key="ThemeSecondaryBackground">#1E1E1E</Color>
    <Color x:Key="ThemeForeground">#F1F1F1</Color>
    <Color x:Key="ThemeSecondaryForeground">#9D9D9D</Color>
    <Color x:Key="ThemeBorder">#3F3F46</Color>

    <!-- Colors used by code-drawn log view elements (see AppTheme.cs). -->
    <Color x:Key="ThemeLogBackground">#1E1E1E</Color>
    <Color x:Key="ThemeLogAlternatingBackground">#252526</Color>
    <Color x:Key="ThemeLogForeground">#DCDCDC</Color>
    <Color x:Key="ThemeLineNumberForeground">#5CB8D6</Color>

    <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="{StaticResource ThemeWindowBackground}" />
    <SolidColorBrush x:Key="ThemePanelBackgroundBrush" Color="{StaticResource ThemePanelBackground}" />
    <SolidColorBrush x:Key="ThemeSecondaryBackgroundBrush" Color="{StaticResource ThemeSecondaryBackground}" />
    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{StaticResource ThemeForeground}" />
    <SolidColorBrush x:Key="ThemeSecondaryForegroundBrush" Color="{StaticResource ThemeSecondaryForeground}" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}" />

</ResourceDictionary>
