<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:loc="clr-namespace:Tailviewer.Localization"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tab="clr-namespace:Metrolib.Controls.Tab;assembly=Metrolib"
                    xmlns:controls="clr-namespace:Metrolib.Controls;assembly=Metrolib"
                    xmlns:mainPanel="clr-namespace:Tailviewer.Ui.About">

    <DataTemplate DataType="{x:Type mainPanel:AboutFlyoutViewModel}">
        <tab:FlatTabControl Padding="0" Foreground="{DynamicResource TextPrimaryBrush}"
                            HorizontalContentAlignment="Center">
            <controls:FlatTabItem Header="{x:Static loc:Strings.Tailviewer}"
                                  HorizontalContentAlignment="Stretch">
                <mainPanel:TailviewerControl />
            </controls:FlatTabItem>

            <controls:FlatTabItem Header="{x:Static loc:Strings.Licenses}"
                                  HorizontalContentAlignment="Stretch">
                <mainPanel:LicenseControl />
            </controls:FlatTabItem>
        </tab:FlatTabControl>
    </DataTemplate>

</ResourceDictionary>