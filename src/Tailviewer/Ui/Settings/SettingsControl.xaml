<UserControl x:Class="Tailviewer.Ui.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Metrolib.Controls;assembly=Metrolib"
             xmlns:tailviewer="clr-namespace:Tailviewer"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:settings="clr-namespace:Tailviewer.Ui.Settings"
             xmlns:loc="clr-namespace:Tailviewer.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance settings:SettingsFlyoutViewModel}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Metrolib;component/Themes/Constants.xaml" />
                <ResourceDictionary Source="CustomFormats/CustomFormatsSettingsDataTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="HeaderDataTemplate">
                <TextBlock FontSize="{StaticResource FontSizeSubtitle}" Text="{Binding}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:FlatScrollViewer VerticalScrollBarVisibility="Auto"
                               HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <controls:FlatGroupBox Header="{x:Static loc:Strings.Language}" Grid.Row="0" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding Language, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Text="{x:Static loc:Strings.LanguageRestartNotice}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Header="{x:Static loc:Strings.ExportGroup}" Grid.Row="1" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Strings.ExportFolder}" Margin="0,6,6,6"/>
                        <controls:PathChooserTextBox Text="{Binding ExportFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PathChooserCommand="{Binding ChooseExportFolderCommand}"
                                                     Grid.Column="1"/>
                    </Grid>
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Grid.Row="2" Header="{x:Static loc:Strings.LogViewerGroup}" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Static loc:Strings.ScrollSpeed}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="0" />
                        <controls:EditorTextBox Grid.Column="1" Grid.Row="0"
                                                Margin="0,6,6,6">
                            <controls:EditorTextBox.Text>
                                <Binding Path="ScrollSpeed"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <tailviewer:Int32RangeRule Minimum="1" Maximum="100" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </controls:EditorTextBox.Text>
                        </controls:EditorTextBox>

                        <TextBlock Text="{x:Static loc:Strings.FontSize}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="1"
                                   Grid.Column="0"/>
                        <controls:EditorTextBox Grid.Column="1" Grid.Row="1"
                                                Margin="0,6,6,6">
                            <controls:EditorTextBox.Text>
                                <Binding Path="FontSize"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <tailviewer:Int32RangeRule Minimum="1" Maximum="100" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </controls:EditorTextBox.Text>
                        </controls:EditorTextBox>

                        <TextBlock Text="{x:Static loc:Strings.TabWidth}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="2"
                                   Grid.Column="0"/>
                        <controls:EditorTextBox Grid.Column="1" Grid.Row="2"
                                                Margin="0,6,6,6">
                            <controls:EditorTextBox.Text>
                                <Binding Path="TabWidth"
                                         Mode="TwoWay"
                                         UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <tailviewer:Int32RangeRule Minimum="1" Maximum="100" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </controls:EditorTextBox.Text>
                        </controls:EditorTextBox>
                    </Grid>
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Grid.Row="3" Header="{x:Static loc:Strings.LogLevelsGroup}" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static loc:Strings.ForegroundColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.BackgroundColor}"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelOther}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="1"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding OtherLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding OtherLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelTrace}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="2"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="2"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding TraceLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding TraceLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelDebug}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="3"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="3"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding DebugLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding DebugLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelInfo}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="4"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="4"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding InfoLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding InfoLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelWarning}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="5"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="5"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding WarningLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding WarningLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelError}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="6"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="6"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding ErrorLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding ErrorLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.LevelFatal}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="7"
                                   Grid.Column="0"/>
                        <Grid Grid.Row="7"
                              Grid.Column="1"
                              Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <xctk:ColorPicker SelectedColor="{Binding FatalLevel.ForegroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness" />
                            <xctk:ColorPicker SelectedColor="{Binding FatalLevel.BackgroundColor}"
                                              AvailableColorsSortingMode="HueSaturationBrightness"
                                              Margin="6,0,0,0"
                                              Grid.Column="1" />
                        </Grid>
                    </Grid>
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Grid.Row="4" Header="{x:Static loc:Strings.ThemeGroup}" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Strings.ThemeColor}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="0"
                                   Grid.Column="0" />
                        <xctk:ColorPicker Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="0,6,6,6"
                                          SelectedColor="{Binding ThemeColor}"
                                          AvailableColorsSortingMode="HueSaturationBrightness" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Margin="0,6,6,6"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ThemeModes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ThemeMode, Mode=TwoWay}" />
                        <Button Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,6,6,6"
                                Padding="12,4"
                                HorizontalAlignment="Left"
                                Content="{x:Static loc:Strings.RestoreDefaultColors}"
                                Command="{Binding RestoreDefaultColorsCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="{DynamicResource PrimaryForegroundBrush}"
                                BorderBrush="{DynamicResource PrimaryDarkBrush}" />
                    </Grid>
                </controls:FlatGroupBox>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:FlatGroupBox Header="{x:Static loc:Strings.DataSourcesGroup}" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Grid.Row="0"
                                  Margin="0,6,6,6"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding FolderDataSourceRecursive, Mode=TwoWay}">
                            <TextBlock Text="{x:Static loc:Strings.FolderDataSourceRecursive}"
                                       TextWrapping="Wrap" />
                        </CheckBox>

                        <TextBlock Text="{x:Static loc:Strings.FolderDataSourceFilter}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="1"
                                   Grid.Column="0"/>
                        <controls:EditorTextBox Grid.Column="1" Grid.Row="1"
                                                Text="{Binding FolderDataSourcePatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{x:Static loc:Strings.FolderPatternHint1}" />
                            <LineBreak />
                            <Run Text="{x:Static loc:Strings.FolderPatternHint2}" />
                            <LineBreak />
                            <Run Text="{x:Static loc:Strings.FolderPatternHint3}" />
                            <LineBreak />
                            <Run Text="{x:Static loc:Strings.FolderPatternHint4}" />
                        </TextBlock>

                        <TextBlock Text="{x:Static loc:Strings.DefaultTextFileEncoding}"
                                   VerticalAlignment="Center"
                                   Margin="0,6,6,6"
                                   Grid.Row="3"
                                   Grid.Column="0" />

                        <ComboBox Grid.Column="1"
                                  Grid.Row="3"
                                  Margin="0,6,6,6"
                                  ItemsSource="{Binding TextFileEncodings}"
                                  SelectedItem="{Binding DefaultTextFileEncoding}"/>
                        <TextBlock Grid.Column="1"
                                   Grid.Row="4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap">
                            <Run Text="{x:Static loc:Strings.EncodingHint1}" />
                            <LineBreak />
                            <Run Text="{x:Static loc:Strings.EncodingHint2}" />
                        </TextBlock>

                    </Grid>
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Header="{x:Static loc:Strings.CustomFormatsGroup}"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}"
                                       Grid.Row="1"
                                       VerticalAlignment="Top" Margin="8">
                    <ContentPresenter Content="{Binding CustomFormats}" />
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Grid.Row="2"
                                       Header="{x:Static loc:Strings.WindowGroup}" VerticalAlignment="Top" Margin="8"
                                       HeaderTemplate="{StaticResource HeaderDataTemplate}">
                    <Grid>
                        <CheckBox Content="{x:Static loc:Strings.AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}" />
                    </Grid>
                </controls:FlatGroupBox>

                <controls:FlatGroupBox Header="{x:Static loc:Strings.UpdatesGroup}" VerticalAlignment="Top" Margin="8"
                                       Grid.Row="3">
                    <controls:FlatGroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="{StaticResource FontSizeSubtitle}" Text="{Binding}" />
                        </DataTemplate>
                    </controls:FlatGroupBox.HeaderTemplate>
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="PART_CheckForUpdates" IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                                      Content="{x:Static loc:Strings.NotifyWhenUpdateAvailable}" Margin="0,4,4,4" />
                            <!--<CheckBox Grid.Row="1" IsChecked="{Binding AutomaticallyInstallUpdates, Mode=TwoWay}" Content="{x:Static loc:Strings.AutoInstallNewest}" IsEnabled="{Binding IsChecked,ElementName=PART_CheckForUpdates}"></CheckBox>-->
                            <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{x:Static loc:Strings.ProxyHint}" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,4">
                                <controls:EditorTextBox Watermark="{x:Static loc:Strings.ProxyUsername}" Width="110"
                                                           Text="{Binding ProxyUsername}" Margin="0,0,4,0"
                                                           IsEnabled="{Binding IsChecked, ElementName=PART_CheckForUpdates}" />
                                <controls:FlatPasswordBox Watermark="{x:Static loc:Strings.ProxyPassword}" Width="110"
                                                          x:Name="PART_ProxyPassword"
                                                          PasswordChanged="OnPasswordChanged"
                                                          Margin="0,0,4,0"
                                                          IsEnabled="{Binding IsChecked, ElementName=PART_CheckForUpdates}" />
                                <controls:EditorTextBox Watermark="{x:Static loc:Strings.ProxyServer}" Width="150"
                                                           Text="{Binding ProxyServer}" Margin="0"
                                                           IsEnabled="{Binding IsChecked, ElementName=PART_CheckForUpdates}" />
                            </StackPanel>
                            
                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Margin="4"
                                       Text="{x:Static loc:Strings.PluginRepositoriesHint}"/>

                            <controls:EditorTextBox Grid.Row="1" Text="{Binding PluginRepositories}"
                                                    TextWrapping="Wrap"
                                                    AcceptsReturn="True" />
                        </Grid>
                    </StackPanel>
                </controls:FlatGroupBox>

            </Grid>
        </Grid>
    </controls:FlatScrollViewer>
</UserControl>
