<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <ProjectGuid>{799F74C7-6DE8-455D-936D-E11D7525AB36}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Tailviewer</RootNamespace>
    <AssemblyName>Tailviewer</AssemblyName>
    <ApplicationIcon>Resources\Tailviewer.ico</ApplicationIcon>
    <StartupObject>Tailviewer.Bootstrapper</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../../sig/key.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.0.1" />
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Metrolib" Version="0.3.0.162" />
    <PackageReference Include="MMQ" Version="1.0.15" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="1.1.0" />
    <PackageReference Include="SharpRemote" Version="0.6.184" />
    <PackageReference Include="System.Threading.Extensions" Version="2.0.72" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Design" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.cs" Link="Properties\GlobalAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\**" />
    <None Remove="Licenses\**" />
    <Resource Include="Resources\**" Exclude="Resources\Icons.xaml;Resources\Fonts\FONTLOG.txt;Resources\Fonts\METADATA.pb" />
    <Resource Include="Licenses\**" />
    <Resource Include="..\..\LICENSE" Link="Licenses\Tailviewer\LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tailviewer.Api\Tailviewer.Api.csproj" />
    <ProjectReference Include="..\Tailviewer.Archiver\Tailviewer.Archiver.csproj" />
    <ProjectReference Include="..\Tailviewer.Core\Tailviewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.zh-CN.resx">
      <WithCulture>true</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyBrandedExecutable" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(TargetDir)Tailviewer NEXT.exe"
          Condition="Exists('$(TargetPath)')" />
    <Copy SourceFiles="$(TargetPath).config"
          DestinationFiles="$(TargetDir)Tailviewer NEXT.exe.config"
          Condition="Exists('$(TargetPath).config')" />
  </Target>

</Project>
